# Copy this file to .env and fill in real values. Never commit .env.

# 32-byte hex key (64 characters). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_64_hex_characters

# MongoDB Atlas connection string (single cluster)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/?retryWrites=true&w=majority
DB_NAME=invexa

# Only this origin is allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# 1 for local development, 0 otherwise
FLASK_DEBUG=1

# Optional: only needed if Tesseract / Poppler are not on your PATH (common on Windows)
TESSERACT_CMD=
POPPLER_PATH=

# Password used by seed_demo.py for all demo accounts (min 8 characters).
# Choose your own. Only needed when running seed_demo.py.
DEMO_PASSWORD=
